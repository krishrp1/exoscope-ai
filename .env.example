# Backend (read by backend/api/settings.py). Copy to .env and adjust.
EXOSCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXOSCOPE_MAX_UPLOAD_MB=10
EXOSCOPE_MAX_UPLOAD_ROWS=500000
EXOSCOPE_MAX_BATCH_SIZE=25
EXOSCOPE_LOG_LEVEL=INFO
# Optional path overrides
# EXOSCOPE_DATA_DIR=./data
# EXOSCOPE_MODELS_DIR=./backend/saved_models
# EXOSCOPE_ARTIFACTS_DIR=./backend/artifacts

# Frontend (copy into frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
